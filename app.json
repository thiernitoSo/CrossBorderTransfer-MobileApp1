{
  "expo": {
    "name": "SendAfrika",
    "slug": "sendafrika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./generated-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./generated-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./generated-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./generated-icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "sendafrika"
  }
}